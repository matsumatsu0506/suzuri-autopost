# このファイルを .env という名前でコピーして、値を書き込んでください。
# .env は .gitignore に入っているので、GitHub には絶対に上がりません。

# SUZURI の API トークン  https://suzuri.jp/developer/apps
SUZURI_API_TOKEN=

# Bluesky のハンドル（例: example.bsky.social）
BLUESKY_IDENTIFIER=

# Bluesky のアプリパスワード（ログインパスワードではありません）
# 設定 → プライバシーとセキュリティ → アプリパスワード
BLUESKY_APP_PASSWORD=

# Gemini API キー  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 使うモデル（省略可）。実測で動作確認済みなのは gemini-3.6-flash です。
GEMINI_MODEL=gemini-3.6-flash

# Threads を使う場合だけ必要（Phase 2）。長期アクセストークン。
THREADS_ACCESS_TOKEN=

# Instagram と Facebookページを使う場合だけ必要（Phase 3）。
# 1. Graph API Explorer で取得した長期ユーザートークンをここに入れて
META_USER_ACCESS_TOKEN=
# 2. npm run meta:setup を実行すると、下のページトークンが自動で入る
#    （ページトークンは期限切れにならない。この1つで Instagram と Facebook の両方に投稿できる）
META_PAGE_ACCESS_TOKEN=
